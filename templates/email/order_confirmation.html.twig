l{% extends 'email/layout.html.twig' %}

{% block content %}
    <h1 style="font-size:24px;margin:0 0 10px">Commande confirmée</h1>
    <p>Bonjour {{ customerName ?: 'cher client' }},</p>
    <p>Merci pour votre commande. Votre commande est confirmée.</p>
    <p><strong>Référence :</strong> #{{ orderReference }}</p>
    <p><strong>Date :</strong> {{ orderDate|date('d/m/Y H:i') }}</p>
    <table style="width:100%;border-collapse:collapse;margin:24px 0">
        <thead>
        <tr style="border-bottom:2px solid {{ primaryColor }};text-align:left">
            <th style="padding:10px 4px">Produit</th>
            <th style="padding:10px 4px;text-align:center">Qté</th>
            <th style="padding:10px 4px;text-align:right">Total</th>
        </tr>
        </thead>
        <tbody>
        {% for item in items %}
            <tr style="border-bottom:1px solid #e5e7eb">
                <td style="padding:12px 4px">
                    {% if item.image %}<img src="{{ item.image }}" alt="" width="42" height="42" style="vertical-align:middle;object-fit:cover;border-radius:6px;margin-right:8px">{% endif %}
                    <strong>{{ item.name }}</strong>
                    {% if item.sku %}<br><small style="color:#6b7280">SKU : {{ item.sku }}</small>{% endif %}
                </td>
                <td style="padding:12px 4px;text-align:center">{{ item.quantity }}</td>
                <td style="padding:12px 4px;text-align:right">{{ ((item.totalCents) / 100)|number_format(2, ',', ' ') }} {{ currency }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div style="text-align:right;font-size:18px"><strong>Total : {{ (totalCents / 100)|number_format(2, ',', ' ') }} {{ currency }}</strong></div>
{% endblock %}
