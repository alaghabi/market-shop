{% extends 'email/layout.html.twig' %}

{% block content %}
    <h1>Réinitialiser votre mot de passe</h1>
    <p>Bonjour {{ name }},</p>
    <p>Cliquez sur le bouton ci-dessous pour choisir un nouveau mot de passe. Ce lien expire dans une heure.</p>
    <p style="margin:28px 0;"><a href="{{ resetUrl }}" style="display:inline-block;background:{{ primaryColor }};color:#fff;text-decoration:none;border-radius:{{ borderRadius }};padding:13px 22px;font-weight:700;">Réinitialiser mon mot de passe</a></p>
    <p style="font-size:13px;line-height:1.6;color:#6b6560;">Si vous n'êtes pas à l'origine de cette demande, vous pouvez ignorer cet email.</p>
{% endblock %}
