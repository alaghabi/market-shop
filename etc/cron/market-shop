# Delivery creation is asynchronous through Messenger; retries and tracking remain periodic.
*/5 * * * * cd /app && php bin/console app:delivery-retry --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2
*/5 * * * * cd /app && php bin/console app:delivery-tracking-sync --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2
*/5 * * * * cd /app && php bin/console app:keycloak:sync-redirect-uris --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2

# Billing and extension housekeeping runs once per day.
5 2 * * * cd /app && php bin/console app:subscription-expiry --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2
10 2 * * * cd /app && php bin/console app:extension-expiry --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2
15 2 * * * cd /app && php bin/console session:cleanup --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2
20 2 * * * cd /app && php bin/console app:loyalty:expire-points --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2
25 2 * * * cd /app && php bin/console media:cleanup --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2
30 2 * * * cd /app && php bin/console app:cleanup-old-data --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2

