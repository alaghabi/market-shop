APP_ENV=test
APP_SECRET=test-secret
DATABASE_URL="postgresql://app:app@database:5432/app_test?serverVersion=16&charset=utf8"
MESSENGER_HIGH_DSN=in-memory://
MESSENGER_WEBHOOK_DSN=in-memory://
MESSENGER_CHATBOT_DSN=in-memory://
MESSENGER_LOGISTICS_DSN=in-memory://
MESSENGER_FAILED_DSN=in-memory://
MAILER_DSN=null://null
MAILER_FROM=no-reply@hanooti.local
APP_PUBLIC_URL=http://localhost:8082
OAUTH2_ISSUER="https://issuer.example.com"
OAUTH2_AUDIENCE="market-shop-api"
OAUTH2_JWKS_URI="https://issuer.example.com/.well-known/jwks.json"
OAUTH2_AUTHORITY="https://issuer.example.com"
OAUTH2_CLIENT_ID="market-shop-spa"
OAUTH2_REDIRECT_URI="http://localhost:8080/oauth/callback"
OAUTH2_POST_LOGOUT_REDIRECT_URI="http://localhost:8080"
OAUTH2_SCOPE="openid profile email offline_access"
KEYCLOAK_ISSUER="https://issuer.example.com/realms/test"
KEYCLOAK_DISCOVERY_BASE_URI="https://issuer.example.com/realms/test/"
KEYCLOAK_AUDIENCE="market-shop-api"
KEYCLOAK_ADMIN_USERNAME="test-admin"
KEYCLOAK_ADMIN_PASSWORD="test-password"
KEYCLOAK_ADMIN_URL="http://keycloak:8080"
KEYCLOAK_REALM="hanooti"
KEYCLOAK_CLIENT_ID="hanooti-web"
KEYCLOAK_PUBLIC_SCHEME="http"
KEYCLOAK_PUBLIC_PORT="8082"
KEYCLOAK_REDIRECT_SYNC_ENABLED=false
