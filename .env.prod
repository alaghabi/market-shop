# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# Run after filling: docker compose exec keycloak bash /opt/keycloak/config/configure-social-providers.sh

